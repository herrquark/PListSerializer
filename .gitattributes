# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# plist files (mainly in tests) should not be messed with
# so we instruct git to consider them binary
*.plist -text

# Preserve archived benchmark bytes and hashes across checkouts.
benchmarks/results/*/* -text
# Original reports and patches contain significant trailing whitespace.
benchmarks/results/*/report.md whitespace=-blank-at-eol
benchmarks/results/*/source.patch whitespace=-blank-at-eol
